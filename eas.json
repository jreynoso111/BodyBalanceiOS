{
  "cli": {
    "version": ">= 16.23.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_GOOGLE_AUTH": "true"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_ENABLE_GOOGLE_AUTH": "true",
        "EXPO_PUBLIC_ANDROID_PREMIUM_SUBSCRIPTION_ID": "premium_annual",
        "EXPO_PUBLIC_ANDROID_PREMIUM_MONTHLY_SUBSCRIPTION_ID": "premium_monthly"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_GOOGLE_AUTH": "true",
        "EXPO_PUBLIC_ANDROID_PREMIUM_SUBSCRIPTION_ID": "premium_annual",
        "EXPO_PUBLIC_ANDROID_PREMIUM_MONTHLY_SUBSCRIPTION_ID": "premium_monthly"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
